# Copy to .env.local for local development. Real values belong in the Vercel
# project settings, never in a file that gets committed.

# Resend API key. Required for leads to reach an inbox — without it the form
# still works and the lead is only written to the server log.
RESEND_API_KEY=

# Optional. Defaults to Resend's shared onboarding sender, which can only
# deliver to the address that owns the Resend account. Once a domain is
# verified in Resend, use it here, e.g. "Better Built <leads@yourdomain.com>".
LEAD_EMAIL_FROM=

# Optional. Defaults to the contact address in lib/site.ts.
LEAD_EMAIL_TO=
